generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model competition {
  competition_id String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  api_id         Int?           @unique
  fd_id          Int?           @unique
  sport_id       String         @db.Uuid
  name           String         @db.VarChar(255)
  logo_url       String?
  sport          sport          @relation(fields: [sport_id], references: [sport_id], onDelete: Cascade, onUpdate: NoAction)
  season         season[]
  user_follows   user_follows[]
}

model match {
  match_id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  api_id                        String?      @unique @db.VarChar(100)
  fd_id                         Int?         @unique
  season_id                     String       @db.Uuid
  home_team_id                  String       @db.Uuid
  away_team_id                  String       @db.Uuid
  start_time                    DateTime     @db.Timestamptz(6)
  status                        match_status @default(SCHEDULED)
  home_score                    Int?
  away_score                    Int?
  home_penalty                  Int?
  away_penalty                  Int?
  home_winner                   Boolean?
  away_winner                   Boolean?
  phase                         String?      @db.VarChar(100)
  events                        Json?
  buteurs_charges               Boolean      @default(false)
  notified_at                   DateTime?    @db.Timestamptz(6)
  team_match_away_team_idToteam team         @relation("match_away_team_idToteam", fields: [away_team_id], references: [team_id], onDelete: NoAction, onUpdate: NoAction)
  team_match_home_team_idToteam team         @relation("match_home_team_idToteam", fields: [home_team_id], references: [team_id], onDelete: NoAction, onUpdate: NoAction)
  season                        season       @relation(fields: [season_id], references: [season_id], onDelete: Cascade, onUpdate: NoAction)
}

model season {
  season_id      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competition_id String      @db.Uuid
  year_label     String      @db.VarChar(50)
  start_date     DateTime?   @db.Date
  end_date       DateTime?   @db.Date
  match          match[]
  competition    competition @relation(fields: [competition_id], references: [competition_id], onDelete: Cascade, onUpdate: NoAction)
}

model sport {
  sport_id    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        @unique @db.VarChar(100)
  competition competition[]
  team        team[]
}

model team {
  team_id                        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  api_id                         Int?    @unique
  fd_id                          Int?    @unique
  name                           String  @db.VarChar(255)
  logo_url                       String?
  sport_id  String  @db.Uuid 
  sport     sport   @relation(fields: [sport_id], references: [sport_id], onDelete: Cascade, onUpdate: NoAction)
  match_match_away_team_idToteam match[] @relation("match_away_team_idToteam")
  match_match_home_team_idToteam match[] @relation("match_home_team_idToteam")
}

model user {
  user_id      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String         @unique @db.VarChar(100)
  email        String         @unique @db.VarChar(255)
  created_at   DateTime?      @default(now()) @db.Timestamptz(6)
  user_follows user_follows[]
}

model user_follows {
  user_id        String      @db.Uuid
  competition_id String      @db.Uuid
  competition    competition @relation(fields: [competition_id], references: [competition_id], onDelete: Cascade, onUpdate: NoAction)
  user           user        @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, competition_id])
}

model push_subscription {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpoint     String   @unique
  p256dh       String
  auth         String
  competitions String[] @default([]) // competition_id suivis → notifié pour tous leurs matchs
  teams        String[] @default([]) // team_id suivis → notifié pour leurs matchs (toutes compétitions)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
}

enum match_status {
  SCHEDULED
  IN_PLAY
  FINISHED
  POSTPONED
}
